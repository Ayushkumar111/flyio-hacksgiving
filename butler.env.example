# Copy to butler.env on the butler Sprite and fill in.
PORT=8080
TASTER=taster
CLEAN=v2
TASTER_KEY=choose-a-long-random-owner-key
SPRITES_TOKEN=your-sprites-api-token
PINECONE_BASE=https://api.sprites.dev/v1/gateway/pinecone/<connection-id>
PINECONE_INDEX=taster-past-lives
LLM_BASE=https://api.sprites.dev/v1/gateway/gemini/<connection-id>
LLM_MODEL=gemini-3.5-flash,gemini-flash-lite-latest,gemini-2.5-flash
